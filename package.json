{
  "name": "@circleback/openclaw-plugin",
  "version": "0.1.3",
  "type": "module",
  "description": "Circleback plugin for OpenClaw.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/circlebackai/openclaw-plugin.git"
  },
  "scripts": {
    "generate": "node scripts/generate-tools.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@circleback/cli": "0.2.2"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2",
      "pluginSdkVersion": "2026.3.24-beta.2"
    }
  }
}
